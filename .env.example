# ---------------------------------------------------------------------------
# Groq API (required)
# Get a key at https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Optional model override (must support the OpenAI-compatible chat endpoint)
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Instagram (optional — needed for private posts or heavy scraping)
# ---------------------------------------------------------------------------
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Path to an Instaloader session file (see README "Creating an Instagram session")
INSTAGRAM_SESSION_FILE=

# ---------------------------------------------------------------------------
# History database
# ---------------------------------------------------------------------------
HISTORY_DB_PATH=analysis_history.db
